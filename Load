-- // Persistent UI preferences (shared by every script using this engine)
local SETTINGS_FOLDER = "VortexHub"
local SETTINGS_FILE = SETTINGS_FOLDER .. "/UI_Settings.json"
local SavedUISettings = {Language = "en", Width = 650, Height = 420, Theme = "purple", ImageId = ""}
local HasSavedFile = false -- true when UI_Settings.json existed and was read OK

pcall(function()
    if not _isfolder(SETTINGS_FOLDER) then _makefolder(SETTINGS_FOLDER) end
    if isfile and isfile(SETTINGS_FILE) then
        local decoded = HttpService:JSONDecode(_readfile(SETTINGS_FILE))
        if type(decoded) == "table" then
            HasSavedFile = true
            SavedUISettings.Language = decoded.Language == "ar" and "ar" or "en"
            SavedUISettings.Width = math.clamp(tonumber(decoded.Width) or 650, 360, 1200)
            SavedUISettings.Height = math.clamp(tonumber(decoded.Height) or 420, 280, 900)
            SavedUISettings.Theme = tostring(decoded.Theme or "purple")
            SavedUISettings.ImageId = tostring(decoded.ImageId or ""):match("%d+") or ""
        end
    end
end)

local ActiveLanguage = SavedUISettings.Language
local LocalizedObjects = {}
local LanguageRefreshers = {}

local function ResolveText(value)
    if type(value) == "table" then
        return tostring(value[ActiveLanguage] or value.en or value.ar or "")
    end
    return tostring(value == nil and "" or value)
end

local function StableKey(value)
    if type(value) == "table" then
        return tostring(value.key or value.en or value.ar or "")
    end
    return tostring(value)
end

local function SameOption(a, b)
    if type(a) == "table" and type(b) == "table" then
        if a.Code ~= nil or b.Code ~= nil then return a.Code == b.Code end
        return a.en == b.en and a.ar == b.ar
    end
    return a == b
end

local function RegisterLocalized(instance, value, propertyName)
    if not instance or value == nil then return end
    propertyName = propertyName or "Text"
    if type(value) == "table" then
        table.insert(LocalizedObjects, {Instance = instance, Value = value, Property = propertyName})
    end
    pcall(function() instance[propertyName] = ResolveText(value) end)
end

-- Writes the settings to disk right now.
-- File exists  -> read it, update Language/Width/Height/Theme/ImageId, write it back.
-- File missing -> create the folder/file and write the settings.
local function WriteSettingsNow()
    pcall(function()
        if not _isfolder(SETTINGS_FOLDER) then _makefolder(SETTINGS_FOLDER) end

        local data = {
            Language = SavedUISettings.Language,
            Width = SavedUISettings.Width,
            Height = SavedUISettings.Height,
            Theme = SavedUISettings.Theme,
            ImageId = SavedUISettings.ImageId
        }

        if isfile and isfile(SETTINGS_FILE) then
            local okRead, existing = pcall(function()
                return HttpService:JSONDecode(_readfile(SETTINGS_FILE))
            end)
            if okRead and type(existing) == "table" then
                for k, v in pairs(data) do existing[k] = v end
                data = existing
            end
        end

        _writefile(SETTINGS_FILE, HttpService:JSONEncode(data))
        HasSavedFile = true
    end)
end

-- Debounced save: every call restarts a 2 second timer.
-- Only the last call (when the user stopped dragging) actually writes.
local SaveToken = 0
local function SaveUISettings()
    SaveToken = SaveToken + 1
    local myToken = SaveToken
    task.delay(2, function()
        if myToken == SaveToken then
            WriteSettingsNow()
        end
    end)
end

