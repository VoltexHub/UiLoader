                function Elements:AddThemeSelector(themeLabel, imageLabel)
                    local themeOptions = {}
                    for _, t in ipairs(ThemeOrder) do
                        table.insert(themeOptions, {en = t.en, ar = t.ar, Code = t.Code})
                    end
                    -- put the saved theme first so the dropdown shows it as selected
                    for i, o in ipairs(themeOptions) do
                        if o.Code == Window:GetTheme() then
