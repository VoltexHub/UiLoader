    -- // BACKGROUND IMAGE (Roblox decal / image id). Empty = remove.
    local imageToken = 0
    local function ApplyBackgroundImage(id, save)
        local digits = id ~= nil and tostring(id):match("%d+") or nil
        imageToken = imageToken + 1
        local myToken = imageToken
        SavedUISettings.ImageId = digits or ""

        if digits then
            hasImage = true
            BGImage.Image = "rbxassetid://" .. digits
            BGImage.ImageTransparency = math.clamp(IMAGE_BASE + Window.CurrentTransparency, 0, 1)
            BGImage.Visible = true
            GradientLayer.Visible = false
            Tween(MainFrame, {BackgroundTransparency = 1}, 0.3) -- the image replaces the solid background
            cardTransparency = 0.25
            -- decal ids sometimes don't load as images: fall back to the thumbnail url
            task.delay(3, function()
                if myToken == imageToken and BGImage.Parent and not BGImage.IsLoaded then
                    BGImage.Image = "rbxthumb://type=Asset&id=" .. digits .. "&w=420&h=420"
                end
            end)
        else
            hasImage = false
            BGImage.Image = ""
            BGImage.Visible = false
            GradientLayer.Visible = ThemeByCode[CurrentThemeCode].Gradient == true
            Tween(MainFrame, {BackgroundTransparency = Window.CurrentTransparency}, 0.3)
            cardTransparency = 0
        end

        for _, data in ipairs(Window.AllCards) do
            if data.Card and data.Card.Parent ~= nil or data.Card then
                data.Card.BackgroundTransparency = cardTransparency
            end
        end
        if save then WriteSettingsNow() end
    end

    function Window:SetBackgroundImage(id)
        ApplyBackgroundImage(id, true)
    end

