-- Live palette (updated in place, so every Pal.X read is always current)
local Pal = {}
local PalHexSet = {}
local CurrentThemeCode = "purple"

local AccentColor, BackgroundColor, CardColor, HoverColor, TextColor, SubTextColor

local function BuildPalette(code)
    local t = ThemeByCode[code] or ThemeByCode.purple
    local p = {Accent = t.Accent, Background = t.Background, Text = t.Text, SubText = t.SubText}
    local hi = t.Light and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
    local lo = t.Light and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
    local used = {}
    for _, c in pairs(p) do used[c:ToHex()] = true end
    for _, r in ipairs(DefaultRoles) do
        local c
        if t.UseDefaults then
            c = r.Color
        else
            c = t.Background:Lerp(r.Level >= 0 and hi or lo, math.abs(r.Level))
            local tries = 0
            while used[c:ToHex()] and tries < 8 do
                c = Color3.fromRGB(
                    math.clamp(math.floor(c.R * 255 + 0.5) + 1, 0, 254),
                    math.clamp(math.floor(c.G * 255 + 0.5) + 1, 0, 254),
                    math.clamp(math.floor(c.B * 255 + 0.5) + 1, 0, 254)
                )
                tries = tries + 1
            end
        end
        used[c:ToHex()] = true
        p[r.Name] = c
    end
    return p
end

local function SetPalette(code)
    if not ThemeByCode[code] then code = "purple" end
    local p = BuildPalette(code)
    for k in pairs(Pal) do Pal[k] = nil end
    PalHexSet = {}
    for k, v in pairs(p) do
        Pal[k] = v
        PalHexSet[v:ToHex()] = true
    end
    CurrentThemeCode = code
    SavedUISettings.Theme = code
    AccentColor, BackgroundColor, CardColor = Pal.Accent, Pal.Background, Pal.Card
    HoverColor, TextColor, SubTextColor = Pal.Hover, Pal.Text, Pal.SubText
end

SetPalette(SavedUISettings.Theme)

local ThemedProps = {BackgroundColor3 = true, TextColor3 = true, ImageColor3 = true, Color = true, ScrollBarImageColor3 = true}

-- Converts an original (purple) colour literal to the active theme colour
local function ThemeColor(c)
    if typeof(c) ~= "Color3" then return c end
    local hex = c:ToHex()
    if PalHexSet[hex] then return c end
    local role = DefaultHexToRole[hex]
    return role and Pal[role] or c
end

-- Re-colours every existing object when the theme changes (old palette -> new palette)
local function RemapGui(root, oldPal)
    local map = {}
    for role, c in pairs(oldPal) do map[c:ToHex()] = Pal[role] end
    local function conv(c) return map[c:ToHex()] end

    for _, d in ipairs(root:GetDescendants()) do
        if not d:GetAttribute("VH_NoTheme") then
            pcall(function()
                if d:IsA("GuiObject") then
                    local n = conv(d.BackgroundColor3)
                    if n then d.BackgroundColor3 = n end
                    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                        n = conv(d.TextColor3)
                        if n then d.TextColor3 = n end
                    end
                    if d:IsA("ImageLabel") or d:IsA("ImageButton") then
                        n = conv(d.ImageColor3)
                        if n then d.ImageColor3 = n end
                    end
                    if d:IsA("ScrollingFrame") then
                        n = conv(d.ScrollBarImageColor3)
                        if n then d.ScrollBarImageColor3 = n end
                    end
                elseif d:IsA("UIStroke") then
                    local n = conv(d.Color)
                    if n then d.Color = n end
                end
            end)
        end
    end
end
